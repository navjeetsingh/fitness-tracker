# Strava API — from strava.com/settings/api
STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here

# Garmin Connect credentials
GARMIN_EMAIL=your_garmin_email@example.com
GARMIN_PASSWORD=your_garmin_password

# Yazio credentials (unofficial API, same trust model as Garmin above)
YAZIO_EMAIL=your_yazio_email@example.com
YAZIO_PASSWORD=your_yazio_password

# Verifies requests to /api/cron/yazio actually came from Vercel Cron
CRON_SECRET=generate_a_random_string

# Auto-provisioned by the Upstash Redis marketplace integration — do not set manually
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Your Vercel deployment URL (update after first deploy)
NEXT_PUBLIC_BASE_URL=https://navjeet-fitness-tracker.vercel.app

# --- Discord bot (bot/) — runs on the Oracle VM, not Vercel ---

# From your Discord Application's "Bot" tab
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Your own Discord user ID (right-click your profile with Developer Mode on ->
# Copy User ID) — the bot only responds to DMs from this ID
OWNER_DISCORD_ID=your_discord_user_id_here

# From `claude setup-token` on the VM — long-lived token for the Claude subscription
# (Pro/Max), used instead of a separately-billed Anthropic API key
CLAUDE_CODE_OAUTH_TOKEN=your_claude_code_oauth_token_here
